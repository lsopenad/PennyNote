    "¿Has olvidado la contraseña? Pide una temporal a quien administra PennyNote y cámbiala después en Ajustes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forgot your password? Ask whoever manages PennyNote for a temporary one and change it later in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忘记密码了？请向 PennyNote 的管理员索取临时密码，之后在设置中更改。"
          }
