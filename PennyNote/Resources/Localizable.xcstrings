    "%lld cambios no se han podido subir. Si cierras sesión ahora se perderán. Prueba antes a sincronizar con conexión a internet.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld change couldn't be uploaded. If you sign out now it will be lost. Try syncing with an internet connection first."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld changes couldn't be uploaded. If you sign out now they will be lost. Try syncing with an internet connection first."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld cambio no se ha podido subir. Si cierras sesión ahora se perderá. Prueba antes a sincronizar con conexión a internet."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld cambios no se han podido subir. Si cierras sesión ahora se perderán. Prueba antes a sincronizar con conexión a internet."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld 项更改未能上传。如果现在退出登录，这些更改将会丢失。请先在联网状态下同步。"
                }
              }
            }
          }
        }
      }
    },
