    "El servidor ha intentado enviar un email y ha llegado a su límite. Avisa a quien administra PennyNote.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server tried to send an email and reached its limit. Tell whoever manages PennyNote."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器尝试发送邮件但已达到上限。请联系 PennyNote 的管理员。"
          }
        }
      }
    },
    "El servidor ha rechazado los datos. Inténtalo de nuevo más tarde.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server rejected the data. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器拒绝了数据。请稍后再试。"
          }
        }
      }
    },
    "El servidor no responde. Inténtalo de nuevo en un momento.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server isn't responding. Try again in a moment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器无响应。请稍后再试。"
          }
        }
      }
    },
    "El servidor pide confirmar el email y no envía correos. Avisa a quien administra PennyNote.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server requires email confirmation and doesn't send emails. Tell whoever manages PennyNote."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器要求确认邮箱且不会发送邮件。请联系 PennyNote 的管理员。"
          }
        }
      }
    },
