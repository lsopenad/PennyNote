    "Borra la cuenta y todos sus gastos y categorías, del servidor y de este iPhone. No se puede deshacer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes the account and all its expenses and categories, from the server and from this iPhone. This can't be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从服务器和此 iPhone 上删除账户及其所有支出和类别。此操作无法撤销。"
          }
        }
      }
    },
