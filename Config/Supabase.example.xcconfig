// Plantilla de configuración de Supabase. Cópiala como Config/Supabase.xcconfig (ignorado por git)
// y pon los valores de Project Settings → API de tu proyecto de Supabase.
//
// En un .xcconfig "//" empieza un comentario, así que la URL se escribe con "$()" entre las dos
// barras: https:/$()/abcdefgh.supabase.co

SUPABASE_URL = https:/$()/your-project-ref.supabase.co
// La anon key (o la publishable key, sb_publishable_...). Es pública: va dentro de la app y los
// datos los protege RLS. Nunca pongas aquí la service_role key ni la secret key.
SUPABASE_ANON_KEY = your-anon-key
